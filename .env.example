# EXAMPLES ONLY: replace all REPLACE_ values; never commit filled environment files.
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
POSTGRES_PORT=55432
REDIS_PORT=56379
# Copy to .env at the repository root. Never commit real credentials.
# Local ports match the isolated compose.yaml; choose your own database password.
NODE_ENV=development
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://navi:REPLACE_WITH_LOCAL_DATABASE_PASSWORD@127.0.0.1:55432/navi
REDIS_URL=redis://127.0.0.1:56379
# Phase 2 web authentication. Prefer separate .env.web and .env.bot files.
# Supply YOUR own Discord application credentials and approved user IDs, not the maintainer's.
# Discord callback is WEB_ORIGIN/api/auth/callback/discord; no trailing slash on origin.
BETTER_AUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_ALLOWED_USER_IDS=
BOT_INTERNAL_URL=http://127.0.0.1:4001
BOT_INTERNAL_SECRET=
# Safe self-hosting baseline; the database queue must be activated deliberately.
BOT_COMMAND_TRANSPORT=http
BOT_COMMAND_ADMISSION_ENABLED=false
BOT_COMMANDS_ENABLED=false

# Bot-only token. Configured bot maintains Gateway presence and owns REST sends.
DISCORD_BOT_TOKEN=
BOT_STATUS_PORT=4001

# Phase 4 optional public-account lookup credentials; web process only.
YOUTUBE_API_KEY=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
STREAMER_SOURCE_LIMIT=10

# Phase 6 worker; prefer a separate .env.worker with its own provider credentials.
MONITORING_ENABLED=false
MONITOR_PUBLIC_ORIGIN=
MONITOR_WEBHOOK_SECRET=
MONITOR_PORT=4100
YOUTUBE_DAILY_BUDGET=7200
# Optional web/worker beta server scope. Configure only after approval; maximum five IDs.
BETA_GUILD_IDS=
