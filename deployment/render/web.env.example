# REVIEW ONLY. Blank values must be set privately after deployment approval.
# WEB_ORIGIN = the exact approved dashboard HTTPS origin, without trailing slash.
NODE_ENV=production
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1
WEB_ORIGIN=
# Direct Neon hostname (no -pooler), sslmode=verify-full; percent-encode credentials.
DATABASE_URL=
BETTER_AUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_ALLOWED_USER_IDS=
BETA_GUILD_IDS=
# Intentional safe default. Render check-web rejects HTTP; only select postgres after approval.
# PostgreSQL mode requires no dashboard broker URL or secret.
BOT_COMMAND_TRANSPORT=http
BOT_COMMAND_ADMISSION_ENABLED=false
YOUTUBE_API_KEY=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
STREAMER_SOURCE_LIMIT=10
