# INVENTORY ONLY: do not start monitoring without separate owner approval.
NODE_ENV=production
LOG_LEVEL=info
# Direct Neon hostname (no -pooler), sslmode=verify-full.
DATABASE_URL=
# Upstash native TCP/TLS URI, rediss://... ; NOT an HTTPS REST URL/token pair.
# Validated legacy setting: the existing durable queue is PostgreSQL, not Redis.
REDIS_URL=
MONITORING_ENABLED=false
BOT_INTERNAL_URL=http://127.0.0.1:4001
BOT_INTERNAL_SECRET=
YOUTUBE_API_KEY=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
MONITOR_PUBLIC_ORIGIN=
MONITOR_WEBHOOK_SECRET=
MONITOR_PORT=4100
YOUTUBE_DAILY_BUDGET=7200
BETA_GUILD_IDS=
