NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL=
# Legacy validated setting; PostgreSQL queue does not use Redis.
REDIS_URL=redis://127.0.0.1:6379
# Deliberately fail production preflight until monitoring is explicitly enabled.
MONITORING_ENABLED=false
BOT_INTERNAL_URL=http://127.0.0.1:4001
BOT_INTERNAL_SECRET=
YOUTUBE_API_KEY=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Real provider callbacks need publicly reachable HTTPS, not localhost.
MONITOR_PUBLIC_ORIGIN=
MONITOR_WEBHOOK_SECRET=
MONITOR_PORT=4100
YOUTUBE_DAILY_BUDGET=7200
